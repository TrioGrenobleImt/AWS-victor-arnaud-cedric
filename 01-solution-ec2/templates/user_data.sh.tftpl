#!/bin/bash
# Bootstraps a web + worker instance (Amazon Linux 2023). Release: ${app_version}
set -euxo pipefail

dnf install -y python3 python3-pip

mkdir -p /opt/shop/static
# Release layout: app code + catalog at the root, Vite build output under static/
aws s3 cp "s3://${artifact_bucket}/releases/${app_version}/" /opt/shop/ --recursive --region "${region}"

python3 -m venv /opt/shop/venv
/opt/shop/venv/bin/pip install --quiet -r /opt/shop/requirements.txt

TOKEN=$(curl -sX PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)

cat > /etc/shop.env <<ENV
AWS_REGION=${region}
DB_HOST=${db_host}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD_SSM=${db_password_ssm}
TOPIC_ARN=${topic_arn}
QUEUE_URL=${queue_url}
CATALOG_FILE=/opt/shop/catalog.json
STATIC_DIR=/opt/shop/static
IMAGES_BUCKET=${images_bucket}
INSTANCE_ID=$INSTANCE_ID
AZ=$AZ
ENV

useradd --system --home /opt/shop shop || true
chown -R shop:shop /opt/shop

cat > /etc/systemd/system/shop-web.service <<UNIT
[Unit]
Description=FISA shop web API
After=network-online.target

[Service]
User=shop
WorkingDirectory=/opt/shop
EnvironmentFile=/etc/shop.env
ExecStart=/opt/shop/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8080 --access-logfile - app:app
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/systemd/system/shop-worker.service <<UNIT
[Unit]
Description=FISA shop order worker (SQS consumer)
After=network-online.target

[Service]
User=shop
WorkingDirectory=/opt/shop
EnvironmentFile=/etc/shop.env
ExecStart=/opt/shop/venv/bin/python -u worker.py
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now shop-web shop-worker
